{
    "name": "webcraft/laravel-captcha",
    "description": "A reusable, extensible CAPTCHA package for Laravel 10+ with image, math and text generators.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "captcha", "security", "validation", "image captcha", "math captcha"],
    "authors": [
        {
            "name": "Shafiqul Islam",
            "email": "albrators@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-gd": "*",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/session": "^10.0|^11.0|^12.0",
        "illuminate/validation": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Webcraft\\LaravelCaptcha\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webcraft\\LaravelCaptcha\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webcraft\\LaravelCaptcha\\CaptchaServiceProvider"
            ],
            "aliases": {
                "Captcha": "Webcraft\\LaravelCaptcha\\Facades\\Captcha"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
